[mariadb]
# Unique node identity and private network interface.
server_id=1
bind_address=<NODE_1_PRIVATE_IP>

# Transactional storage and Galera replication requirements.
default_storage_engine=InnoDB
binlog_format=ROW
innodb_autoinc_lock_mode=2

# Preserve local commit durability.
innodb_flush_log_at_trx_commit=1
innodb_doublewrite=ON

# Conservative settings for these small lab instances.
innodb_buffer_pool_size=128M
max_connections=30

# Galera provider and shared cluster membership.
wsrep_on=ON
wsrep_provider=/usr/lib/libgalera_smm.so
wsrep_cluster_name=gigavolt-cluster
wsrep_cluster_address=gcomm://<NODE_1_PRIVATE_IP>,<NODE_2_PRIVATE_IP>,<NODE_3_PRIVATE_IP>

# This node's advertised identity and state-transfer address.
wsrep_node_name=gigavolt-node1
wsrep_node_address=<NODE_1_PRIVATE_IP>
wsrep_sst_receive_address=<NODE_1_PRIVATE_IP>:4444

# Full state transfer; temporarily blocks the donor.
wsrep_sst_method=rsync

# Disk cache for incremental recovery.
wsrep_provider_options="gcache.size=128M;gcache.recover=yes"
